# ---- Text2SQL V1 : runtime configuration contract (see text2sql_V1.md section 7) ----
# Copy to .env and fill in real values. Never commit .env.

# MySQL target database (V1 business views only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_text2sql
DB_USER=text2sql_readonly
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SQL execution policy
SQL_DIALECT=mysql
SQL_MAX_ROWS=100
SQL_TIMEOUT_SECONDS=30
SQL_MAX_RETRIES=2
CATALOG_VERSION=v1

# Optional: how the validator treats LIMIT problems
#   normalize -> rewrite missing/oversized LIMIT to SQL_MAX_ROWS
#   reject    -> refuse a statement without a valid LIMIT
SQL_LIMIT_POLICY=normalize

# Optional: read catalog metadata from MySQL catalog_* tables instead of YAML
# CATALOG_SOURCE=yaml            # yaml | mysql
# CATALOG_DSN=mysql+pymysql://user:password@127.0.0.1:3306/ecommerce_text2sql?charset=utf8mb4

# LLM provider (OpenAI-compatible chat completions endpoint)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
